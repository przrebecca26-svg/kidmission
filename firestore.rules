rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function membership(familyId) {
      return get(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }

    function isActiveMember(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid))
        && membership(familyId).data.revoked != true;
    }

    function isParent(familyId) {
      return isActiveMember(familyId) && membership(familyId).data.role == 'parent';
    }

    // True only if the caller is the uid recorded as ownerUid on the family doc.
    function isFamilyOwner(familyId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/families/$(familyId))
        && get(/databases/$(database)/documents/families/$(familyId)).data.ownerUid == request.auth.uid;
    }

    // A child may only touch data under their OWN childId — never another sibling's.
    function isSelf(familyId, childId) {
      return isActiveMember(familyId)
        && membership(familyId).data.role == 'child'
        && membership(familyId).data.childId == childId;
    }

    function isParentOrSelf(familyId, childId) {
      return isParent(familyId) || isSelf(familyId, childId);
    }

    // ---- Collection-group lookup (findFamilyIdForUid) -------------------
    // Lets a signed-in user find THEIR OWN membership doc across all families
    // (query: collectionGroup("members").where("uid", "==", myUid)).
    // Never exposes anyone else's membership.
    match /{path=**}/members/{memberUid} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ---- families/{familyId} -------------------------------------------

    match /families/{familyId} {
      allow read: if isActiveMember(familyId);
      // Created client-side during signUpParent(); ownerUid must match the creator.
      // "create" only applies to a NEW document, so an existing family can't be taken over.
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Only the onboardingSeen flag may be changed, by a parent, and ownerUid can never change.
      allow update: if isParent(familyId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboardingSeen']);
      allow delete: if false; // account deletion goes through a server-side function
    }

    // ---- families/{familyId}/members/{uid} ------------------------------

    match /families/{familyId}/members/{uid} {
      // Read your OWN membership doc, or any member doc if you're a parent of this family.
      allow read: if isSignedIn() && (request.auth.uid == uid || isParent(familyId));

      // SECURITY FIX (17/11/2026): a parent member doc can only be created by the
      // OWNER of the family (ownerUid on families/{familyId}). Before this fix, any
      // signed-in user could add themselves as "parent" to any family whose ID they knew.
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.role == 'parent'
        && request.resource.data.uid == uid
        && isFamilyOwner(familyId);

      // Child member docs are created by Maman's session (see auth.js: the write uses
      // the PARENT's Firestore connection even though the credential itself was minted
      // via the secondary auth app) — so this must check the caller is an existing parent.
      allow create: if isParent(familyId)
        && request.resource.data.role == 'child'
        && request.resource.data.uid == uid;

      // Nobody can change a member's role or uid — prevents a child from
      // promoting themselves to parent.
      allow update: if isParent(familyId)
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid;

      allow delete: if isParent(familyId);
    }

    // ---- families/{familyId}/children/{childId} -------------------------

    match /families/{familyId}/children/{childId} {
      allow read: if isParentOrSelf(familyId, childId);
      allow create, update: if isParent(familyId);
      allow delete: if false; // deletion intentionally not exposed to the client
    }

    // ---- Per-child data ---------------------------------------------------

    match /families/{familyId}/children/{childId}/settings/{doc} {
      allow read: if isParentOrSelf(familyId, childId);
      allow write: if isParent(familyId);
    }

    match /families/{familyId}/children/{childId}/entries/{entryId} {
      allow read: if isParentOrSelf(familyId, childId);
      // A child can only create their OWN pending entries, with their own uid
      // and a server timestamp.
      allow create: if isParent(familyId)
        || (isSelf(familyId, childId)
            && request.resource.data.status == 'pending'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time);
      allow update: if isParent(familyId); // only Maman approves/rejects/edits
      allow delete: if isParent(familyId);
    }

    match /families/{familyId}/children/{childId}/payments/{paymentId} {
      allow read: if isParentOrSelf(familyId, childId);
      allow write: if isParent(familyId);
    }

    match /families/{familyId}/children/{childId}/rewardClaims/{claimId} {
      allow read: if isParentOrSelf(familyId, childId);
      allow create: if isParent(familyId)
        || (isSelf(familyId, childId)
            && request.resource.data.status == 'pending'
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time);
      allow update: if isParent(familyId);
      allow delete: if isParent(familyId);
    }
  }
}
